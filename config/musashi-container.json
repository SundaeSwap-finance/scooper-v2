{
  "log": {
    "level": "info"
  },
  "persistence": {
    "sqlite": {
      "filename": "/app/data/scooper-musashi.db"
    }
  },
  "protocol": {
    "bootstrap": {
      "source": "blockfrost",
      "url": "http://sundae-bf-proxy:3009",
      "project-id": "musashi"
    }
  },
  "acropolis": {
    "module": {
      "peer-network-interface": {
        "node-addresses": [
          "musashi-node:3010"
        ],
        "peer-sharing-enabled": false,
        "min-hot-peers": 1,
        "target-peer-count": 1
      },
      "local-chain-follower": {
        "socket-path": "/data/node.socket",
        "network-magic": 164,
        "block-topic": "cardano.block.proposed"
      }
    }
  }
}
